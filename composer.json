{
    "name": "rishadblack/sylloo-app-base",
    "description": "The shared base of the Sylloo device apps (Sylloo POS, Sylloo App desktop and mobile): activation, Sign in with browser, PIN and lock, device states, release, the office calls and the REST client with its offline waiting list, updates, their screens (one logic, a Livewire + wire-bootstrap web face), look, texts in English, Bangla and Finnish, and test helpers.",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "S M Rishad",
            "email": "rishad.black@gmail.com",
            "homepage": "https://smrishad.com"
        }
    ],
    "homepage": "https://github.com/rishadblack/sylloo-app-base",
    "keywords": [
        "laravel",
        "livewire",
        "nativephp",
        "sylloo",
        "device"
    ],
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "illuminate/cache": "^12.0|^13.0",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/encryption": "^12.0|^13.0",
        "illuminate/filesystem": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/view": "^12.0|^13.0",
        "jantinnerezo/livewire-alert": "^4.0",
        "livewire/livewire": "^4.0",
        "rishadblack/larahelpers": "^2.0",
        "rishadblack/wire-bootstrap": "^1.1",
        "rishadblack/wire-modals": "^1.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0|^5.0",
        "pestphp/pest-plugin-laravel": "^4.0|^5.0",
        "pestphp/pest-plugin-livewire": "^4.0|^5.0"
    },
    "autoload": {
        "psr-4": {
            "Rishadblack\\SyllooAppBase\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Rishadblack\\SyllooAppBase\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest --compact",
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "check": [
            "@lint:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Rishadblack\\SyllooAppBase\\SyllooAppBaseServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
